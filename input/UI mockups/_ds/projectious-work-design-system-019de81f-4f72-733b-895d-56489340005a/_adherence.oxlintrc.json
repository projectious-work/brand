{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/agent-console/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Source Sans 3|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Source Sans 3, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:dark|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pipeline'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|tag|status|lastRun|owner|runs|key|ref|className|style|children)$/]",
        "message": "<Pipeline> doesn't accept that prop. Declared props: id, name, tag, status, lastRun, owner, runs."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pipeline'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:healthy|running|warning|failed|idle)$/]",
        "message": "<Pipeline> status must be one of 'healthy' | 'running' | 'warning' | 'failed' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunDetail'] > JSXAttribute > JSXIdentifier[name!=/^(?:pipeline|theme|key|ref|className|style|children)$/]",
        "message": "<RunDetail> doesn't accept that prop. Declared props: pipeline, theme."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNav|theme|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: active, onNav, theme."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: theme."
      },
      {
        "selector": "JSXOpeningElement[name.name='Topbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|theme|mode|onToggleMode|key|ref|className|style|children)$/]",
        "message": "<Topbar> doesn't accept that prop. Declared props: title, theme, mode, onToggleMode."
      },
      {
        "selector": "JSXOpeningElement[name.name='Topbar'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Topbar> mode must be one of 'light' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
