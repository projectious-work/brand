# ── Project-specific ─────────────────────────────────────────────────────────
# Add your project-specific ignore patterns here.

# Scratch space for material handed to the repo from outside — briefings,
# delivered artefacts, anything not yet placed. Whatever is worth keeping gets
# committed to where it belongs; this directory itself never does.
tmp/

# `hugo mod vendor` output in the theme examples. The examples resolve their
# theme through the Go module cache; a vendored tree shadows that and pins the
# theme to whatever was vendored, silently.
examples/*/_vendor/


# ── aibox generated ────────────────────────────────────────────────────────
# Files generated by aibox — do not remove these entries.
.devcontainer/Dockerfile
.devcontainer/docker-compose.yml
.devcontainer/devcontainer.json
.aibox-home/
.root/
.aibox-version
.aibox/
.aibox-backup/
.aibox-env/

# ── OS generated files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# ── Editor / IDE ─────────────────────────────────────────────────────────────
*.swp
*.swo
*~
.idea/


# aibox generated

.agents/skills/
.aibox-local.toml
.aibox-local.env
context/.cache/
context/.state/
context/private/
context/**/private/
.mcp.json
.cursor/mcp.json
.gemini/settings.json
.codex/config.toml
.codex/hooks.json
.continue/mcpServers/

.latex-cache/

# =============================================================================
# Hugo / Docsy
# =============================================================================
public/
resources/_gen/
# A pattern with an internal slash is anchored to this directory, so the line
# above never matched the theme examples' own build caches.
examples/*/resources/_gen/
examples/*/public/
.hugo_build.lock
node_modules/

# Theme examples staged for the authoring server by scripts/serve-docs.sh.
src/static/examples/
