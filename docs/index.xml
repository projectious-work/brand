	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;File&lt;/th&gt;
					&lt;th&gt;Format&lt;/th&gt;
					&lt;th&gt;Use&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a href="https://projectious-work.github.io/brand/downloads/tokens/variables.css"&gt;&lt;code&gt;variables.css&lt;/code&gt;&lt;/a&gt;&lt;/td&gt;
