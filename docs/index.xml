			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a href="https://projectious-work.github.io/brand/downloads/tokens/tailwind.config.js"&gt;&lt;code&gt;tailwind.config.js&lt;/code&gt;&lt;/a&gt;&lt;/td&gt;
